// Secrets (set with `wrangler secret put`, or in .dev.vars locally):
//   GITHUB_TOKEN          optional no-scope server token: the fallback for public
//                         repos a viewer's token cannot reach (src/lib/token-source.ts)
//   TOKEN_ENCRYPTION_KEY  key for encrypting per-user GitHub tokens at rest
//   GITHUB_CLIENT_ID      the bilan GitHub App (user-to-server OAuth login)
//   GITHUB_CLIENT_SECRET
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bilan",
  // Worker entry: re-exports the Astro fetch handler plus `scheduled` and the workflow class.
  "main": "./src/worker.ts",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bilan",
      "database_id": "a706a39a-208a-4e35-a8f0-cb7ed1c029a4",
      "migrations_dir": "../store-d1/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "PAYLOADS",
      "bucket_name": "bilan-payloads",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "5d8223fa9ec74ff3b172ff74b408a98f",
    },
  ],
  "workflows": [
    {
      "binding": "SYNC_REPO",
      "name": "sync-repo",
      "class_name": "SyncRepoWorkflow",
    },
  ],
  // Served on bilan.dev only (the zone must be on this Cloudflare account). The
  // workers.dev host and per-version preview URLs are off: the GitHub App
  // callback is bound to one host.
  "routes": [{ "pattern": "bilan.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": ["0 6 * * *"],
  },
  "vars": {
    // URL slug of the GitHub App (https://github.com/apps/<slug>); the 404 page links to its install screen.
    "GITHUB_APP_SLUG": "bilan-app",
  },
  "observability": {
    "enabled": true,
  },
}
