---
import '@bilan/ui/dist/bilan-ui.css';
import '../styles/site.css';

import BrandMark from '../components/BrandMark.astro';
import PrivateLock from '../components/PrivateLock.astro';
import UserMenu from '../components/UserMenu.astro';
import { FONT_FACES, PRELOAD_FONTS } from '../styles/fonts.ts';

import type { SessionUser } from '../lib/session.ts';

interface Props {
  title: string;
  user: SessionUser | null;
  /** Shown as `owner / name` after the wordmark on repository pages. */
  crumb?: { owner: string; name: string; isPrivate?: boolean };
  /** Where to land after signing in; defaults to the current page. */
  next?: string;
  /** Page summary for search results and link previews. */
  description?: string;
}

const {
  title,
  user,
  crumb,
  next,
  description = 'The pulse of a GitHub repository: who is contributing, which areas are moving, how reviews flow, and where work gets stuck.',
} = Astro.props;
/** Link previews need an absolute image URL; the app sets no `site`, so build it per request. */
const ogImage = new URL('/brand/og.png', Astro.url).href;
---

<!doctype html>
<html lang="en" data-theme="auto">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/brand/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/brand/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <link rel="manifest" href="/brand/site.webmanifest" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0d0e10" />
    <meta property="og:site_name" content="bilan" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="[bilan): the pulse of a GitHub repository" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // Apply the saved theme before first paint; `auto` follows the OS.
      try {
        var t = localStorage.getItem('bilan-theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    {
      PRELOAD_FONTS.map((href) => (
        <link rel="preload" href={href} as="font" type="font/woff2" crossorigin="anonymous" />
      ))
    }
    <style is:inline set:html={FONT_FACES} />
  </head>
  <body>
    <header class="hdr">
      <div class="hdr-in">
        <a class="wordmark" href="/" aria-label="bilan, home">
          <BrandMark size={18} />
          bilan
        </a>
        {
          crumb && (
            <span class="crumb">
              <a
                class="crumb-link"
                href={`https://github.com/${crumb.owner}/${crumb.name}`}
                target="_blank"
                rel="noopener"
                title={`${crumb.owner}/${crumb.name} on GitHub`}
              >
                <span class="sep" aria-hidden="true">/</span>
                <span class="owner">{crumb.owner}</span>
                <span class="sep" aria-hidden="true">/</span>
                <b>{crumb.name}</b>
              </a>
              {crumb.isPrivate && <PrivateLock id="crumb" />}
            </span>
          )
        }
        {
          Astro.slots.has('status') && (
            <div class="hdr-status">
              <slot name="status" />
            </div>
          )
        }
        <div class="hdr-right">
          <slot name="actions" />
          <div class="seg theme-seg" role="group" aria-label="Theme" id="theme-seg">
            <button
              type="button"
              data-theme-pick="auto"
              aria-pressed="true"
              aria-label="System theme"
              title="System theme"
            >
              <svg class="icon" viewBox="0 0 16 16" aria-hidden="true">
                <path
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linejoin="round"
                  d="M2.5 3.5h11v7.5h-11zM6 13.5h4M8 11v2.5"
                />
              </svg>
            </button>
            <button
              type="button"
              data-theme-pick="light"
              aria-pressed="false"
              aria-label="Light theme"
              title="Light theme"
            >
              <svg class="icon" viewBox="0 0 16 16" aria-hidden="true">
                <circle cx="8" cy="8" r="2.75" fill="none" stroke="currentColor" stroke-width="1.5" />
                <path
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  d="M8 1.5v1.25M8 13.25v1.25M1.5 8h1.25M13.25 8h1.25M3.4 3.4l.9.9M11.7 11.7l.9.9M3.4 12.6l.9-.9M11.7 4.3l.9-.9"
                />
              </svg>
            </button>
            <button
              type="button"
              data-theme-pick="dark"
              aria-pressed="false"
              aria-label="Dark theme"
              title="Dark theme"
            >
              <svg class="icon" viewBox="0 0 16 16" aria-hidden="true">
                <path
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linejoin="round"
                  d="M13.5 9.6A5.75 5.75 0 0 1 6.4 2.5a5.75 5.75 0 1 0 7.1 7.1Z"
                />
              </svg>
            </button>
          </div>
          <UserMenu user={user} {...(next === undefined ? {} : { next })} />
        </div>
      </div>
    </header>
    <slot />
    <script>
      // One theme for the whole site, chosen here: `data-theme` on <html>,
      // remembered in localStorage. The dashboard redraws its charts when the
      // attribute changes (see `mount` in @bilan/ui).
      const html = document.documentElement;
      /** The browser chrome follows a forced theme too, not only the OS scheme. */
      const PAGE = { light: '#ffffff', dark: '#0d0e10' } as const;
      const themeColors = document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]');
      const paintChrome = (): void => {
        const t = html.dataset.theme;
        for (const meta of themeColors) {
          const own = meta.media.includes('dark') ? PAGE.dark : PAGE.light;
          meta.content = t === 'light' || t === 'dark' ? PAGE[t] : own;
        }
      };
      const buttons = document.querySelectorAll<HTMLButtonElement>('[data-theme-pick]');
      const press = (): void => {
        const current = html.dataset.theme ?? 'auto';
        for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.themePick === current));
      };
      for (const b of buttons) {
        b.addEventListener('click', () => {
          html.dataset.theme = b.dataset.themePick ?? 'auto';
        });
      }
      new MutationObserver(() => {
        press();
        paintChrome();
        try {
          const t = html.dataset.theme ?? 'auto';
          if (t === 'auto') localStorage.removeItem('bilan-theme');
          else localStorage.setItem('bilan-theme', t);
        } catch {
          /* storage may be unavailable; the choice still applies to this page */
        }
      }).observe(html, { attributes: true, attributeFilter: ['data-theme'] });
      press();
      paintChrome();
    </script>
  </body>
</html>
