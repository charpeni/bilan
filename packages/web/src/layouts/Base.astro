---
import '@fontsource-variable/inter';
import '@bilan/ui/dist/bilan-ui.css';
import '../styles/site.css';

import UserMenu from '../components/UserMenu.astro';

import type { SessionUser } from '../lib/session.ts';

interface Props {
  title: string;
  user: SessionUser | null;
  /** Shown as `owner / name` after the wordmark on repository pages. */
  crumb?: { owner: string; name: string; isPrivate?: boolean };
  /** The dashboard carries its own theme control; the header's is hidden then. */
  hideTheme?: boolean;
  /** Where to land after signing in; defaults to the current page. */
  next?: string;
}

const { title, user, crumb, hideTheme = false, next } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="auto">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <script is:inline>
      // Apply the saved theme before first paint; `auto` follows the OS.
      try {
        var t = localStorage.getItem('bilan-theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <header class="hdr">
      <div class="hdr-in">
        <a class="wordmark" href="/">bilan</a>
        {
          crumb && (
            <span class="crumb">
              <span class="sep">/</span>
              <span class="owner">{crumb.owner}</span>
              <span class="sep">/</span>
              <b>{crumb.name}</b>
              {crumb.isPrivate && (
                <svg class="icon" viewBox="0 0 16 16" aria-label="Private" role="img">
                  <title>Private</title>
                  <path
                    fill="currentColor"
                    d="M4 6V4.5a4 4 0 1 1 8 0V6h.5A1.5 1.5 0 0 1 14 7.5v6a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 2 13.5v-6A1.5 1.5 0 0 1 3.5 6H4Zm1.5 0h5V4.5a2.5 2.5 0 0 0-5 0V6Z"
                  />
                </svg>
              )}
            </span>
          )
        }
        <slot name="status" />
        <div class="hdr-right">
          <slot name="actions" />
          {
            !hideTheme && (
              <div class="seg" role="group" aria-label="Theme" id="theme-seg">
                <button type="button" data-theme-pick="auto" aria-pressed="true">
                  Auto
                </button>
                <button type="button" data-theme-pick="light" aria-pressed="false">
                  Light
                </button>
                <button type="button" data-theme-pick="dark" aria-pressed="false">
                  Dark
                </button>
              </div>
            )
          }
          <UserMenu user={user} {...(next === undefined ? {} : { next })} />
        </div>
      </div>
    </header>
    <slot />
    <script>
      // One theme for the whole site: `data-theme` on <html>, remembered in
      // localStorage. The dashboard's own control writes the same attribute,
      // so observing it keeps the two in step.
      const html = document.documentElement;
      const buttons = document.querySelectorAll<HTMLButtonElement>('[data-theme-pick]');
      const press = (): void => {
        const current = html.dataset.theme ?? 'auto';
        for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.themePick === current));
      };
      for (const b of buttons) {
        b.addEventListener('click', () => {
          html.dataset.theme = b.dataset.themePick ?? 'auto';
        });
      }
      new MutationObserver(() => {
        press();
        try {
          const t = html.dataset.theme ?? 'auto';
          if (t === 'auto') localStorage.removeItem('bilan-theme');
          else localStorage.setItem('bilan-theme', t);
        } catch {
          /* storage may be unavailable; the choice still applies to this page */
        }
      }).observe(html, { attributes: true, attributeFilter: ['data-theme'] });
      press();
    </script>
  </body>
</html>
