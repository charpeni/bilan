---
import '@bilan/ui/dist/bilan-ui.css';
import '../styles/site.css';

import BrandMark from '../components/BrandMark.astro';
import Footer from '../components/Footer.astro';
import PrivateLock from '../components/PrivateLock.astro';
import UserMenu from '../components/UserMenu.astro';
import { FONT_FACES, PRELOAD_FONTS } from '../styles/fonts.ts';

import type { SessionUser } from '../lib/session.ts';

interface Props {
  title: string;
  user: SessionUser | null;
  /** Shown as `owner / name` after the wordmark on repository pages. */
  crumb?: { owner: string; name: string; isPrivate?: boolean };
  /** Where to land after signing in; defaults to the current page. */
  next?: string;
  /** Page summary for search results and link previews. */
  description?: string;
}

const {
  title,
  user,
  crumb,
  next,
  description = 'The pulse of a GitHub repository: who is contributing, which areas are moving, how reviews flow, and where work gets stuck.',
} = Astro.props;
/** Link previews need an absolute image URL; the app sets no `site`, so build it per request. */
const ogImage = new URL('/brand/og.png', Astro.url).href;
---

<!doctype html>
<html lang="en" data-theme="auto">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/brand/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/brand/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <link rel="manifest" href="/brand/site.webmanifest" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0d0e10" />
    <meta property="og:site_name" content="bilan" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="bilan: the pulse of a GitHub repository" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // Apply the saved theme before first paint; `auto` follows the OS.
      try {
        var t = localStorage.getItem('bilan-theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    {
      PRELOAD_FONTS.map((href) => (
        <link rel="preload" href={href} as="font" type="font/woff2" crossorigin="anonymous" />
      ))
    }
    <style is:inline set:html={FONT_FACES} />
  </head>
  <body>
    <header class="hdr">
      <div class="hdr-in">
        <a class="wordmark" href="/" aria-label="bilan, home">
          <BrandMark size={18} />
          bilan
        </a>
        {
          crumb && (
            <span class="crumb">
              <a
                class="crumb-link"
                href={`https://github.com/${crumb.owner}/${crumb.name}`}
                target="_blank"
                rel="noopener"
                title={`${crumb.owner}/${crumb.name} on GitHub`}
              >
                <span class="sep" aria-hidden="true">/</span>
                <span class="owner">{crumb.owner}</span>
                <span class="sep" aria-hidden="true">/</span>
                <b>{crumb.name}</b>
              </a>
              {crumb.isPrivate && <PrivateLock id="crumb" />}
            </span>
          )
        }
        {
          Astro.slots.has('status') && (
            <div class="hdr-status">
              <slot name="status" />
            </div>
          )
        }
        <div class="hdr-right">
          <slot name="actions" />
          <button
            type="button"
            class="theme-cycle"
            id="theme-cycle"
            data-theme-cycle
            aria-label="Theme: follows the system. Switch to light."
            title="Theme: follows the system. Switch to light."
          >
            <svg class="i i-auto" viewBox="0 0 16 16" aria-hidden="true">
              <rect x="1.5" y="2.5" width="13" height="9" rx="1" fill="none" stroke="currentColor" stroke-width="1.5" />
              <path d="M5.5 14h5M8 11.5V14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            </svg>
            <svg class="i i-light" viewBox="0 0 16 16" aria-hidden="true">
              <circle cx="8" cy="8" r="3" fill="none" stroke="currentColor" stroke-width="1.5" />
              <path d="M8 1.5v2M8 12.5v2M1.5 8h2M12.5 8h2M3.4 3.4l1.4 1.4M11.2 11.2l1.4 1.4M3.4 12.6l1.4-1.4M11.2 4.8l1.4-1.4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            </svg>
            <svg class="i i-dark" viewBox="0 0 16 16" aria-hidden="true">
              <path d="M13.5 10.2A6 6 0 0 1 5.8 2.5a6 6 0 1 0 7.7 7.7Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
            </svg>
          </button>
          <UserMenu user={user} {...(next === undefined ? {} : { next })} />
        </div>
      </div>
    </header>
    <slot />
    <Footer />
    <script>
      // One theme for the whole site, chosen here: `data-theme` on <html>,
      // remembered in localStorage. The dashboard redraws its charts when the
      // attribute changes (see `mount` in @bilan/ui).
      const html = document.documentElement;
      /** The browser chrome follows a forced theme too, not only the OS scheme. */
      const PAGE = { light: '#ffffff', dark: '#0d0e10' } as const;
      const themeColors = document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]');
      const paintChrome = (): void => {
        const t = html.dataset.theme;
        for (const meta of themeColors) {
          const own = meta.media.includes('dark') ? PAGE.dark : PAGE.light;
          meta.content = t === 'light' || t === 'dark' ? PAGE[t] : own;
        }
      };
      // One button cycles auto → light → dark; the visible icon is the current
      // state (CSS on `data-theme`), the label says what a click does next.
      const ORDER = ['auto', 'light', 'dark'] as const;
      type Theme = (typeof ORDER)[number];
      const NAME: Record<Theme, string> = { auto: 'follows the system', light: 'light', dark: 'dark' };
      const isTheme = (v: string | undefined): v is Theme => (ORDER as readonly string[]).includes(v ?? '');
      const cycle = document.querySelector<HTMLButtonElement>('[data-theme-cycle]');
      const nextOf = (t: Theme): Theme => ORDER[(ORDER.indexOf(t) + 1) % ORDER.length] as Theme;
      const press = (): void => {
        const t = html.dataset.theme;
        const current: Theme = isTheme(t) ? t : 'auto';
        const label = `Theme: ${NAME[current]}. Switch to ${NAME[nextOf(current)]}.`;
        cycle?.setAttribute('aria-label', label);
        cycle?.setAttribute('title', label);
      };
      cycle?.addEventListener('click', () => {
        const t = html.dataset.theme;
        html.dataset.theme = nextOf(isTheme(t) ? t : 'auto');
      });
      new MutationObserver(() => {
        press();
        paintChrome();
        try {
          const t = html.dataset.theme ?? 'auto';
          if (t === 'auto') localStorage.removeItem('bilan-theme');
          else localStorage.setItem('bilan-theme', t);
        } catch {
          /* storage may be unavailable; the choice still applies to this page */
        }
      }).observe(html, { attributes: true, attributeFilter: ['data-theme'] });
      press();
      paintChrome();
    </script>
  </body>
</html>
