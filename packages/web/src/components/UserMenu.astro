---
import { env } from 'cloudflare:workers';

import { isOauthConfigured } from '../lib/oauth.ts';

import type { SessionUser } from '../lib/session.ts';

interface Props {
  user: SessionUser | null;
  /** Where to land after signing in; defaults to the current page. */
  next?: string;
}

const { user } = Astro.props;
const next = Astro.props.next ?? Astro.url.pathname + Astro.url.search;
const loginHref = `/auth/github/start?next=${encodeURIComponent(next)}`;
const configured = isOauthConfigured(env);
---

{
  user ? (
    <details class="menu" id="user-menu">
      <summary aria-label={`Account: ${user.login}`}>
        {user.avatarUrl ? (
          <img class="avatar" src={user.avatarUrl} alt="" width="24" height="24" />
        ) : (
          <span class="avatar" />
        )}
        <span>{user.login}</span>
        <svg class="icon" viewBox="0 0 16 16" aria-hidden="true">
          <path
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            d="m4 6 4 4 4-4"
          />
        </svg>
      </summary>
      <div class="pop" role="menu">
        <a class="pop-item" role="menuitem" href="/me">
          Your repos
        </a>
        <form method="post" action="/auth/logout">
          <button class="pop-item" role="menuitem" type="submit">
            Sign out
          </button>
        </form>
      </div>
    </details>
  ) : configured ? (
    <a class="btn" href={loginHref}>
      <svg class="icon" viewBox="0 0 16 16" aria-hidden="true">
        <path
          fill="currentColor"
          d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
        />
      </svg>
      Sign in with GitHub
    </a>
  ) : (
    <button class="btn" type="button" disabled title="GITHUB_CLIENT_ID is not set">
      Sign in with GitHub
    </button>
  )
}

<script>
  // A <details> popover closes on outside click and Escape, like a menu should.
  const menu = document.getElementById('user-menu') as HTMLDetailsElement | null;
  if (menu) {
    document.addEventListener('click', (event) => {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) menu.open = false;
    });
  }
</script>
