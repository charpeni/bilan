---
/**
 * The bilan mark, inlined: the half-open interval "[ )", the window of time a
 * pulse is read over. The square bracket closes the start of the window and
 * takes the accent (`--accent`) unless `accent` is false; the parenthesis
 * leaves the end open (the story is still going) and follows `currentColor`.
 * Below 24px it switches to the
 * pixel-snapped 16-unit drawing used by the favicon. `size` is the height of
 * the bracket; the parenthesis tips overshoot it slightly (overflow is
 * visible). Geometry and usage rules: public/brand/README.md.
 */
interface Props {
  /** Bracket height in px; the width follows the mark's proportions. */
  size?: number;
  /** Paint the bracket in the accent colour. When false the whole mark is `currentColor`. */
  accent?: boolean;
  /** Accessible name. Omit when the mark sits next to the visible word "bilan". */
  title?: string;
  class?: string;
}

const { size = 20, accent = true, title, class: className } = Astro.props;

const small = size < 24;
const box = small ? { x: 2, y: 2, w: 12, h: 12 } : { x: 8, y: 10, w: 47, h: 44 };
const bracket = small ? 'M2 2H6V4H4V12H6V14H2Z' : 'M8 10H24V18H16V46H24V54H8Z';
const paren = small
  ? 'M9.8 2.48C13.6 4.98 13.6 11.02 9.8 13.52'
  : 'M41 12.94C54 19.94 54 44.06 41 51.06';
const stroke = small ? 2.1 : 8.5;
const width = Math.round(((size * box.w) / box.h) * 100) / 100;
---

<svg
  class:list={['brand-mark', className]}
  viewBox={`${box.x} ${box.y} ${box.w} ${box.h}`}
  width={width}
  height={size}
  role={title ? 'img' : undefined}
  aria-label={title}
  aria-hidden={title ? undefined : 'true'}
  focusable="false"
>
  <path fill={accent ? 'var(--accent)' : 'currentColor'} d={bracket}></path>
  <path fill="none" stroke="currentColor" stroke-width={stroke} d={paren}></path>
</svg>

<style>
  .brand-mark {
    flex: none;
    overflow: visible;
  }
</style>
