---
/**
 * The bilan mark, inlined: the ledger b, a lowercase b drawn as a bar chart.
 * The stem is the axis every figure is read from and takes the accent
 * (`--accent`) unless `accent` is false; the bars that come off it trace the
 * bowl and follow `currentColor`. Below 24px it switches to the pixel-snapped
 * 16-unit drawing used by the favicon. `size` is the height of the stem. In a
 * flex row, align the row's items to the baseline: the mark sits on it like a
 * letter. Geometry and usage rules: public/brand/README.md.
 */
interface Props {
  /** Stem height in px; the width follows the mark's proportions. */
  size?: number;
  /** Paint the stem in the accent colour. When false the whole mark is `currentColor`. */
  accent?: boolean;
  /** Accessible name. Omit when the mark sits next to the visible word "bilan". */
  title?: string;
  class?: string;
}

const { size = 20, accent = true, title, class: className } = Astro.props;

const small = size < 24;
const box = small ? { x: 3, y: 1, w: 9, h: 14 } : { x: 15, y: 5, w: 34, h: 54 };
const stem = small ? 'M3 1H5V15H3Z' : 'M15 5H23V59H15Z';
const bars = small
  ? 'M5 4H9V6H5ZM5 7H12V9H5ZM5 10H12V12H5ZM5 13H9V15H5Z'
  : 'M23 22H39V29H23ZM23 32H49V39H23ZM23 42H49V49H23ZM23 52H39V59H23Z';
const width = Math.round(((size * box.w) / box.h) * 100) / 100;
---

<svg
  class:list={['brand-mark', className]}
  viewBox={`${box.x} ${box.y} ${box.w} ${box.h}`}
  width={width}
  height={size}
  role={title ? 'img' : undefined}
  aria-label={title}
  aria-hidden={title ? undefined : 'true'}
  focusable="false"
>
  <path fill={accent ? 'var(--accent)' : 'currentColor'} d={stem}></path>
  <path fill="currentColor" d={bars}></path>
</svg>

<style>
  .brand-mark {
    flex: none;
  }
</style>
