---
import { getRepoByName, touchRepoView } from '@bilan/store-d1';
import { env } from 'cloudflare:workers';

import BrandMark from '../../components/BrandMark.astro';
import RepoNotFound from '../../components/RepoNotFound.astro';
import Base from '../../layouts/Base.astro';
import { accessDeps, checkRepoAccess } from '../../lib/access.ts';
import { getDb } from '../../lib/db.ts';
import { findExample } from '../../lib/examples.ts';
import {
  fmtAgo,
  fmtCoverage,
  fmtDay,
  fmtHistory,
  fmtInstant,
} from '../../lib/format.ts';
import { findActiveJob } from '../../lib/jobs.ts';
import { isOauthConfigured, loginHref as loginHrefFor } from '../../lib/oauth.ts';
import { allowAutoRefresh, repoPageState } from '../../lib/repo-page.ts';
import { isStale, needsRefresh } from '../../lib/stale.ts';

import type { Repo } from '@bilan/store-d1';

const { owner, name } = Astro.params as { owner: string; name: string };
const label = `${owner}/${name}`;
const user = Astro.locals.user;
/** A built-in example: a static full-history snapshot, served to anyone (see `lib/examples.ts`). */
const example = findExample(owner, name);
const loginHref = loginHrefFor(Astro.url.pathname);
const apiBase = `/api/repos/${encodeURIComponent(owner)}/${encodeURIComponent(name)}`;
const now = new Date().toISOString();

let repo: Repo | undefined;
let view: 'ready' | 'syncing' | 'not-found' | 'unavailable' | 'sign-in';
/**
 * A job this viewer started, whose status they may read on `/api/sync/:id`.
 * Anyone else's job answers 404 there, so the page is never handed such an
 * id: it watches the payload endpoint instead (see `lib/poll.ts`).
 */
let ownJobId: string | null = null;
/** Whether some job is queued or running, whoever started it. */
let syncActive = false;

if (example) {
  // Nothing to decide: no row, no access check, no sync, whoever is looking.
  view = 'ready';
} else if (!user) {
  // Signed out, the answer never depends on what bilan has cached: the built-in
  // examples are static, anything else is the same sign-in card (a shared link
  // explains itself before sending anyone to GitHub), built from the label alone.
  view = 'sign-in';
  Astro.response.status = 401;
} else {
  const db = getDb(env);
  const cached = await getRepoByName(db, owner, name);
  // An unknown name takes the same GitHub round trip as a private row the viewer
  // cannot see, so a login redirect, a 503, or the 404 page never tells them
  // apart. A viewer whose token is gone throws `ReauthRequiredError`; the
  // middleware sends them to login.
  const access = await checkRepoAccess(accessDeps(env), user, cached ?? { owner, name });
  if (access.kind === 'login-required') return Astro.redirect(loginHref, 302);
  ({ view, repo } = repoPageState(access, cached));
  if (repo) {
    await touchRepoView(db, { repoId: repo.id, userId: user.id, now });
    const active = await findActiveJob(db, repo.id);
    syncActive = active !== undefined;
    ownJobId = active && user && active.requestedBy === user.id ? active.id : null;
  }
  if (view === 'unavailable') {
    Astro.response.status = 503;
    Astro.response.headers.set('retry-after', '60');
  }
}

const syncedAt = repo?.lastSyncedAt ?? null;
const stale = isStale(syncedAt);
/** Signed-in viewers sync on their token; an example is a snapshot and is never synced. */
const canSync = user !== null && !example;
/**
 * Kick off a background 30-day refresh on the viewer's token when the payload
 * is over an hour old, or when the last run was `partial` (cut by the page
 * budget) so the rest gets reconciled without waiting for the payload to age.
 */
const autoRefresh =
  allowAutoRefresh(Astro.request) && canSync && view === 'ready' && !syncActive && repo !== undefined && needsRefresh(repo);
const oauthReady = isOauthConfigured(env);
/** The chip's tooltip: the absolute instant and exactly what the payload holds. */
const chipTitle =
  syncedAt === null
    ? ''
    : `Synced ${fmtInstant(syncedAt)}. ${
        (repo?.coverageSince ?? null) === null
          ? 'Full history.'
          : `Activity ${fmtCoverage(repo?.coverageSince ?? null)}, plus open pull requests.`
      }${stale ? ' Older than an hour.' : ''}`;
---

<Base title={`${label} · bilan`} user={user} crumb={{ owner, name, isPrivate: repo?.isPrivate ?? false }}>
  <Fragment slot="status">
    {
      example && (
        <span
          class="chip"
          id="sync-chip"
          title={`Built-in example: a full-history snapshot taken ${fmtInstant(example.snapshotAt)}. Not live data.`}
        >
          <span class="dot" aria-hidden="true" />
          <span>
            Snapshot <time datetime={example.snapshotAt}>{fmtDay(example.snapshotAt)}</time>
          </span>
          <span class="chip-extra">· full history</span>
        </span>
      )
    }
    {
      !example && view === 'ready' && syncedAt !== null && (
        <span
          class="chip"
          id="sync-chip"
          data-stale={stale ? '' : undefined}
          data-busy={autoRefresh ? '' : undefined}
          title={chipTitle}
        >
          <span class="dot" aria-hidden="true" />
          <span>
            Synced{' '}
            <time id="synced-at" datetime={syncedAt}>
              {fmtAgo(syncedAt, Date.parse(now))}
            </time>
          </span>
          <span class="chip-extra">· {fmtHistory(repo?.coverageSince ?? null, syncedAt)}</span>
          <span class="chip-state" id="chip-state">
            {autoRefresh ? '· refreshing…' : stale ? '· out of date' : ''}
          </span>
        </span>
      )
    }
  </Fragment>
  <Fragment slot="actions">
    {
      view === 'ready' && canSync && (
        <button
          class="btn"
          type="button"
          id="resync"
          title="Sync the last 30 days again on your GitHub token"
        >
          <svg class="icon" viewBox="0 0 16 16" aria-hidden="true">
            <path
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M13.5 8a5.5 5.5 0 1 1-1.6-3.9M13.5 2.5v3h-3"
            />
          </svg>
          <span class="long" id="resync-label">Refresh</span>
        </button>
      )
    }
  </Fragment>
  {
    view === 'ready' && (
      <main class="dash">
        <div class="dash-top">
        {example && (
          <div class="banner">
            <p>
              <span class="label">Built-in example</span>A snapshot of {example.repo} from {fmtDay(example.snapshotAt)},
              shipped with bilan; it is not live data.
            </p>
            {user ? (
              <a class="btn btn-sm" href="/repositories">
                Open your own repository
              </a>
            ) : oauthReady ? (
              <a class="btn btn-sm btn-primary" href={loginHrefFor('/repositories')}>
                Sign in to open your own
              </a>
            ) : null}
          </div>
        )}
        <div class="notice" id="status" role="status" aria-live="polite" hidden>
          <span id="status-text" />
          <button class="btn btn-sm" type="button" id="status-action" hidden />
        </div>
        </div>
        <div
          id="bilan"
          data-auto-refresh={autoRefresh ? '1' : '0'}
          data-sync-active={syncActive ? '1' : '0'}
          data-own-job-id={ownJobId ?? ''}
          data-login-href={loginHref}
          data-stale={stale ? '1' : '0'}
        />
        <script>
          import { LoadMoreError, loadingText, mount } from '@bilan/ui';

          import { fmtCount, liveCount, splitAtCount } from '../../lib/count-up.ts';
          import { fmtAgo, fmtHistory, fmtInstant } from '../../lib/format.ts';
          import { SYNCED_AT_HEADER, watchAfterSyncResponse } from '../../lib/poll.ts';
          import { isStale } from '../../lib/stale.ts';
          import {
            describeSync,
            finalReadyText,
            interimText,
            observe,
            syncLine,
          } from '../../lib/sync-status.ts';
          import { watchSync } from '../../lib/sync-watch.ts';

          import type { SyncWatch } from '../../lib/poll.ts';
          import type { Liveness, SyncView } from '../../lib/sync-status.ts';
          import type { Payload } from '@bilan/core';
          import type { Mounted, Range, Theme } from '@bilan/ui';

          const root = document.getElementById('bilan') as HTMLElement;
          const status = document.getElementById('status') as HTMLElement;
          const statusText = document.getElementById('status-text') as HTMLElement;
          const statusAction = document.getElementById('status-action') as HTMLButtonElement;
          const chip = document.getElementById('sync-chip');
          const chipState = document.getElementById('chip-state');
          const resync = document.getElementById('resync') as HTMLButtonElement | null;
          const resyncLabel = document.getElementById('resync-label');
          const loginHref = root.dataset.loginHref ?? '/auth/github/start';
          const [, owner, name] = location.pathname.split('/');
          const base = `/api/repos/${owner}/${name}`;

          /** Range button -> sync depth; `'30'` is always covered so it never gets here. */
          const DEPTH: Record<Range, '30d' | '90d' | '180d' | 'all'> = {
            '30': '30d',
            '90': '90d',
            '180': '180d',
            all: 'all',
          };

          let mounted: Mounted | undefined;
          /** The payload on screen, so a status line can say what it covers. */
          let shown: Payload | null = null;
          /** Set while this page follows a first sync that published an interim payload. */
          let firstSync = false;
          /** One sync at a time from this page: a load, a refresh, or the background refresh. */
          let busy = false;

          /** What the notice's button does right now, if it shows one. */
          let statusRun: (() => void) | null = null;
          statusAction.addEventListener('click', () => statusRun?.());

          /** The notice under the header, with an optional action button. */
          const show = (
            text: string,
            state?: 'error' | 'busy',
            action?: { label: string; run: () => void },
          ): void => {
            status.hidden = false;
            statusText.textContent = text;
            if (state) status.dataset.state = state;
            else delete status.dataset.state;
            statusAction.hidden = action === undefined;
            statusAction.textContent = action?.label ?? '';
            statusRun = action?.run ?? null;
          };
          const hideNotice = (): void => {
            status.hidden = true;
          };
          const setChipState = (text: string): void => {
            if (chipState) chipState.textContent = text;
          };

          const postSync = (depth: '30d' | '90d' | '180d' | 'all'): Promise<Response> =>
            fetch(`${base}/sync`, {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ depth }),
            });

          /** The `syncedAt` of the payload on screen: the baseline a wait for a newer one starts from. */
          let currentSyncedAt: string | null = null;

          /** Read the current payload; null while the first sync is still running. */
          async function fetchPayload(): Promise<Payload | null> {
            const response = await fetch(`${base}/payload`, { cache: 'no-store' });
            if (response.status === 202) return null;
            if (!response.ok) throw new Error(`Could not load the dashboard (${response.status}).`);
            currentSyncedAt = response.headers.get(SYNCED_AT_HEADER) ?? currentSyncedAt;
            return (await response.json()) as Payload;
          }

          /** The site's theme (see Base.astro), so mounting never resets it. */
          const currentTheme = (): Theme => {
            const t = document.documentElement.dataset.theme;
            return t === 'light' || t === 'dark' ? t : 'auto';
          };

          /** Point the header chip at the payload on screen. */
          function updateChip(payload: Payload): void {
            const time = document.getElementById('synced-at') as HTMLTimeElement | null;
            if (!time || !payload.syncedAt) return;
            time.dateTime = payload.syncedAt;
            time.textContent = fmtAgo(payload.syncedAt);
            const extra = chip?.querySelector('.chip-extra');
            if (extra) extra.textContent = `· ${fmtHistory(payload.coverageSince, payload.syncedAt)}`;
            const stale = isStale(payload.syncedAt);
            root.dataset.stale = stale ? '1' : '0';
            chip?.toggleAttribute('data-stale', stale);
            chip?.setAttribute('title', `Synced ${fmtInstant(payload.syncedAt)}.`);
            if (!chip?.hasAttribute('data-busy')) setChipState(stale ? '· out of date' : '');
          }

          function render(payload: Payload, initialRange?: Range): void {
            const range = initialRange ?? mounted?.range();
            mounted?.destroy();
            mounted = mount(root, payload, {
              theme: currentTheme(),
              themeControl: false,
              ...(range === undefined ? {} : { initialRange: range }),
              onLoadMore: (next) => loadMore(next),
            });
            shown = payload;
            updateChip(payload);
          }

          /** What a refused `POST /sync` means for the person who clicked. */
          function refusal(code: number, body: { message?: string }): LoadMoreError {
            if (code === 401) {
              return new LoadMoreError('Your GitHub session has expired.', {
                label: 'Sign in again',
                href: loginHref,
              });
            }
            if (code === 429) {
              return new LoadMoreError(
                body.message ? `${body.message}.` : 'This repository was synced a moment ago.',
              );
            }
            if (code === 503) return new LoadMoreError('GitHub is unavailable right now. Try again in a minute.');
            return new LoadMoreError(body.message ?? `The sync could not start (${code}).`);
          }

          /**
           * The load-more note beside the range buttons, its figure counting up
           * between probes rather than jumping (the whole note is tabular-figured).
           */
          const noteParts = { prefix: '', before: '', after: '' };
          // The progress line lives in the sticky notice under the header, so it
          // stays in view wherever the reader has scrolled; the range button
          // keeps only its spinner.
          const noteCount = liveCount((v) => {
            show(`${noteParts.prefix} ${noteParts.before}${fmtCount(v)}${noteParts.after}`, 'busy');
          });
          const progressNote = (prefix: string, view: SyncView): void => {
            const text = syncLine(view);
            const split = view.count === null ? null : splitAtCount(text, fmtCount(view.count));
            if (split === null || view.count === null) {
              show(`${prefix} ${text}`, 'busy');
              return;
            }
            Object.assign(noteParts, { prefix, ...split });
            noteCount.set(view.count);
          };

          /** Start a sync (or ride along with a running one) and wait until it publishes. */
          async function syncAndWait(depth: '30d' | '90d' | '180d' | 'all', onProgress: (view: SyncView) => void): Promise<Payload> {
            const baseline = currentSyncedAt;
            const response = await postSync(depth);
            const body = (await response.json().catch(() => ({}))) as { jobId?: string; message?: string };
            // 409: a sync is already running; ride along with it through the payload.
            const watch: SyncWatch | null = watchAfterSyncResponse(response.status, body, baseline);
            if (watch === null) throw refusal(response.status, body);
            let liveness: Liveness | null = null;
            await watchSync(watch, baseline, {
              apiBase: base,
              fetch: (input, init) => fetch(input, init),
              onProgress: (progress) => {
                liveness = observe(liveness, progress.prsStored, Date.now());
                onProgress(describeSync(progress, liveness));
              },
            });
            const payload = await fetchPayload();
            if (!payload) throw new LoadMoreError('The new data is not ready yet. Reload in a moment.');
            return payload;
          }

          /** Ask for a deeper sync; the dashboard shows the busy state and any error beside the range buttons. */
          async function loadMore(range: Range): Promise<void> {
            if (busy) {
              throw new LoadMoreError(
                firstSync
                  ? 'The first sync is still running. Longer ranges can be synced once it finishes.'
                  : 'A refresh is still running. Try again in a moment.',
              );
            }
            busy = true;
            try {
              const payload = await syncAndWait(DEPTH[range], (view) => progressNote(loadingText(range), view));
              hideNotice();
              render(payload, range);
            } finally {
              busy = false;
            }
          }

          /** The header's Refresh: a 30-day sync, then the dashboard again in place. */
          async function refresh(): Promise<void> {
            if (busy || !resync) return;
            busy = true;
            resync.disabled = true;
            if (resyncLabel) resyncLabel.textContent = 'Refreshing…';
            chip?.setAttribute('data-busy', '');
            setChipState('· refreshing…');
            show('Refreshing the last 30 days…');
            try {
              const payload = await syncAndWait('30d', (view) => show(`Refreshing the last 30 days… ${syncLine(view)}`));
              chip?.removeAttribute('data-busy');
              render(payload);
              show('Up to date.');
              setTimeout(hideNotice, 4000);
            } catch (error) {
              chip?.removeAttribute('data-busy');
              setChipState(root.dataset.stale === '1' ? '· out of date' : '');
              const action = error instanceof LoadMoreError ? error.action : undefined;
              show(error instanceof Error ? error.message : String(error), 'error', action && {
                label: action.label,
                run: () => location.assign(action.href),
              });
            } finally {
              busy = false;
              resync.disabled = false;
              if (resyncLabel) resyncLabel.textContent = 'Refresh';
            }
          }

          /**
           * Out of date (or last run unfinished) and signed in: refresh in the
           * background and offer the result without pulling the page from under
           * the reader. A running job (409) is followed; a refusal leaves the
           * chip saying the data is out of date.
           */
          async function backgroundRefresh(): Promise<void> {
            busy = true;
            chip?.setAttribute('data-busy', '');
            setChipState('· refreshing…');
            try {
              // Resolves only once a payload newer than the one on screen is published.
              const payload = await syncAndWait('30d', () => undefined);
              chip?.removeAttribute('data-busy');
              setChipState('· newer data ready');
              show(
                `Newer data is ready (synced ${payload.syncedAt ? fmtAgo(payload.syncedAt) : 'just now'}).`,
                undefined,
                {
                  label: 'Show it',
                  run: () => {
                    render(payload);
                    hideNotice();
                  },
                },
              );
            } catch {
              chip?.removeAttribute('data-busy');
              setChipState(root.dataset.stale === '1' ? '· out of date' : '');
            } finally {
              busy = false;
            }
          }

          /** How much history the payload on screen holds: `last 7 days`, `full history`. */
          const shownHistory = (): string =>
            fmtHistory(shown?.coverageSince ?? null, shown?.syncedAt ?? null);

          /**
           * A staged first sync published an interim payload (the last 7 days)
           * and keeps reading: say what is on screen and how the rest is
           * going, then offer the final payload when it lands rather than
           * swapping the numbers under the reader.
           */
          async function followFirstSync(): Promise<void> {
            busy = true;
            firstSync = true;
            if (resync) resync.disabled = true;
            chip?.setAttribute('data-busy', '');
            setChipState('· still syncing');
            const baseline = currentSyncedAt;
            const ownJobId = root.dataset.ownJobId || null;
            const watch: SyncWatch = ownJobId
              ? { kind: 'job', jobId: ownJobId }
              : { kind: 'payload', baseline };
            let liveness: Liveness | null = null;
            show(interimText(shownHistory(), null, null));
            try {
              await watchSync(watch, baseline, {
                apiBase: base,
                fetch: (input, init) => fetch(input, init),
                onProgress: (progress) => {
                  liveness = observe(liveness, progress.prsStored, Date.now());
                  show(interimText(shownHistory(), describeSync(progress, liveness), progress.stageLabel));
                },
              });
              const payload = await fetchPayload();
              if (!payload) throw new Error('The new data is not ready yet. Reload in a moment.');
              chip?.removeAttribute('data-busy');
              setChipState('· newer data ready');
              show(finalReadyText(fmtHistory(payload.coverageSince, payload.syncedAt)), undefined, {
                label: 'Update the dashboard',
                run: () => {
                  render(payload);
                  hideNotice();
                },
              });
            } catch (error) {
              chip?.removeAttribute('data-busy');
              setChipState('');
              show(error instanceof Error ? error.message : String(error), 'error', {
                label: 'Reload',
                run: () => location.reload(),
              });
            } finally {
              busy = false;
              firstSync = false;
              if (resync) resync.disabled = false;
            }
          }

          async function load(): Promise<void> {
            try {
              const payload = await fetchPayload();
              if (!payload) {
                show('Syncing… the dashboard appears when the first sync finishes.');
                setTimeout(() => void load(), 5000);
                return;
              }
              hideNotice();
              render(payload);
              if (root.dataset.syncActive === '1') void followFirstSync();
              else if (root.dataset.autoRefresh === '1') void backgroundRefresh();
            } catch (error) {
              show(error instanceof Error ? error.message : String(error), 'error', {
                label: 'Try again',
                run: () => location.reload(),
              });
            }
          }

          resync?.addEventListener('click', () => void refresh());
          void load();
        </script>
      </main>
    )
  }
  {
    view === 'syncing' && (
      <main class="state">
        <div class="state-card">
          <p class="eyebrow state-rail">
            <BrandMark size={14} />
            First sync
          </p>
          <div class="state-body">
            <h1>{label}</h1>
            <p class="progress-text" id="detail" role="status" aria-live="polite">
              {syncActive ? 'Starting…' : 'Ready to sync'}
            </p>
            <div class="progress" id="progress" hidden={!syncActive} aria-hidden="true" />
            <p class="progress-sub" id="detail-2" />
            <p class="progress-warn" id="stall" hidden>
              <svg class="icon" viewBox="0 0 16 16" aria-hidden="true">
                <path class="flag-tri" d="M8 1.5 15 14H1z" />
                <path class="flag-mark" d="M8 6v4M8 11.6v.4" />
              </svg>
              <span id="stall-text" />
            </p>
            <p id="message">
              {syncActive
                ? 'bilan is reading the last 30 days of activity, plus every open pull request, on your GitHub token.'
                : 'Start a sync to read the last 30 days of activity, plus every open pull request, on your GitHub token.'}
            </p>
            <div id="expect" hidden={!syncActive}>
              <h2>What happens next</h2>
              <p class="muted small">
                This usually takes under a minute; very busy repositories take a few. You can leave
                this page: the sync keeps running, and the dashboard will be here (and in{' '}
                <a href="/repositories">your repositories</a>) when it is done.
              </p>
            </div>
            <div class="actions" id="retry" hidden={syncActive}>
              {canSync ? (
                <>
                  <button class="btn btn-primary" type="button" id="restart">
                    {syncActive ? 'Start again' : 'Start sync'}
                  </button>
                  <a class="btn btn-primary" id="sign-in-again" href={loginHref} hidden>
                    Sign in again
                  </a>
                </>
              ) : (
                <a class="btn btn-primary" href={Astro.url.pathname}>
                  Try again
                </a>
              )}
              <a class="btn" href="/repositories">
                Your repositories
              </a>
            </div>
            <div
              id="sync"
              data-api-base={apiBase}
              data-own-job-id={ownJobId ?? ''}
              data-sync-active={syncActive ? '1' : '0'}
            />
          </div>
        </div>
        <script>
          import { fmtCount, liveCount, splitAtCount } from '../../lib/count-up.ts';
          import { watchAfterSyncResponse } from '../../lib/poll.ts';
          import { describeSync, observe } from '../../lib/sync-status.ts';
          import { watchSync } from '../../lib/sync-watch.ts';

          import type { SyncWatch } from '../../lib/poll.ts';
          import type { Liveness, SyncView } from '../../lib/sync-status.ts';

          const sync = document.getElementById('sync') as HTMLElement;
          const message = document.getElementById('message') as HTMLElement;
          const detail = document.getElementById('detail') as HTMLElement;
          const detail2 = document.getElementById('detail-2') as HTMLElement;
          const stall = document.getElementById('stall') as HTMLElement;
          const stallText = document.getElementById('stall-text') as HTMLElement;
          const progress = document.getElementById('progress') as HTMLElement;
          const expect = document.getElementById('expect') as HTMLElement;
          const retry = document.getElementById('retry') as HTMLElement;
          const restart = document.getElementById('restart') as HTMLButtonElement | null;
          const signInAgain = document.getElementById('sign-in-again');
          const intro = 'bilan is reading the last 30 days of activity, plus every open pull request, on your GitHub token.';
          const apiBase = sync.dataset.apiBase as string;
          const ownJobId = sync.dataset.ownJobId || null;
          const syncActive = sync.dataset.syncActive === '1';

          /** The figure in the headline, in its own tabular-figure span so it can count up in place. */
          const figure = document.createElement('span');
          figure.className = 'num';
          const figureCount = liveCount((v) => {
            figure.textContent = fmtCount(v);
          });
          const paintHeadline = (view: SyncView): void => {
            const split = view.count === null ? null : splitAtCount(view.headline, fmtCount(view.count));
            if (split === null || view.count === null) {
              detail.textContent = view.headline;
              return;
            }
            // The words around the figure update as text; the figure counts to its new value.
            detail.replaceChildren(split.before, figure, split.after);
            figureCount.set(view.count);
          };

          /** How much is done (primary), how long it has taken, and whether it is still moving. */
          const paint = (view: SyncView): void => {
            paintHeadline(view);
            detail2.textContent = view.detail;
            stall.hidden = view.warning === null;
            stallText.textContent = view.warning ?? '';
            progress.dataset.state = view.state;
            if (view.fraction === null) {
              delete progress.dataset.determinate;
              progress.style.removeProperty('--fraction');
            } else {
              progress.dataset.determinate = '';
              progress.style.setProperty('--fraction', String(view.fraction));
            }
          };

          /** `expired`: the session's GitHub token is gone, so only signing in again helps. */
          const fail = (text: string, expired = false): void => {
            if (restart) restart.hidden = expired;
            if (signInAgain) signInAgain.hidden = !expired;
            message.setAttribute('role', 'alert');
            message.textContent = text;
            message.dataset.state = 'error';
            detail.textContent = '';
            detail.hidden = true;
            detail2.hidden = true;
            stall.hidden = true;
            progress.hidden = true;
            expect.hidden = true;
            retry.hidden = false;
          };

          /** Back to the working state, for a new attempt from this page. */
          const reset = (): void => {
            message.removeAttribute('role');
            message.textContent = intro;
            delete message.dataset.state;
            detail.hidden = false;
            detail2.hidden = false;
            detail.textContent = 'Starting…';
            progress.hidden = false;
            expect.hidden = false;
            retry.hidden = true;
          };

          /**
           * Reload once the first payload is published. Own jobs are read on
           * their row; anyone else's through the payload endpoint, which never
           * needs a job id (see `lib/poll.ts`).
           */
          async function follow(watch: SyncWatch): Promise<void> {
            let liveness: Liveness | null = null;
            try {
              await watchSync(watch, null, {
                apiBase,
                fetch: (input, init) => fetch(input, init),
                onProgress: (p) => {
                  liveness = observe(liveness, p.prsStored, Date.now());
                  paint(describeSync(p, liveness));
                },
                // A staged run's interim payload is enough to open the dashboard.
                untilFirstPayload: true,
              });
              detail.textContent = 'Opening the dashboard…';
              location.reload();
            } catch (error) {
              fail(error instanceof Error ? error.message : String(error));
            }
          }

          async function start(): Promise<void> {
            try {
              const response = await fetch(`${apiBase}/sync`, { method: 'POST' });
              const body = (await response.json().catch(() => ({}))) as {
                jobId?: string;
                message?: string;
              };
              const watch = watchAfterSyncResponse(response.status, body, null);
              if (watch === null) {
                if (response.status === 401) fail('Your GitHub session has expired. Sign in again to sync.', true);
                else fail(body.message ?? `The sync could not start (${response.status}).`);
                return;
              }
              await follow(watch);
            } catch (error) {
              fail(error instanceof Error ? error.message : String(error));
            }
          }

          restart?.addEventListener('click', () => {
            reset();
            void start();
          });

          if (ownJobId) void follow({ kind: 'job', jobId: ownJobId });
          else if (syncActive) void follow({ kind: 'payload', baseline: null });
        </script>
      </main>
    )
  }
  {view === 'not-found' && <RepoNotFound label={label} user={user} />}
  {
    view === 'unavailable' && (
      <main class="state">
        <div class="state-card">
          <p class="eyebrow state-rail">
            <BrandMark size={14} />
            Temporarily unavailable
          </p>
          <div class="state-body">
            <h1>{label}</h1>
            <p>
              GitHub is not answering right now, so bilan cannot check whether you may see this
              repository. Nothing is wrong with your access.
            </p>
            <div class="actions">
              <a class="btn btn-primary" href={Astro.url.pathname}>
                Try again
              </a>
              <a class="btn" href="/repositories">
                Your repositories
              </a>
            </div>
          </div>
        </div>
      </main>
    )
  }
  {
    view === 'sign-in' && (
      <main class="state">
        <div class="state-card">
          <p class="eyebrow state-rail">
            <BrandMark size={14} />
            Sign in needed
          </p>
          <div class="state-body">
            <h1>{label}</h1>
            <p>
              Sign in with GitHub to see what is moving in this repository. The dashboard opens for
              anyone who can see the repository on GitHub.
            </p>
            <p class="muted small">
              bilan reads pull request metadata with read-only permissions and never writes to your
              repositories.
            </p>
            <div class="actions">
              {oauthReady ? (
                <a class="btn btn-primary" href={loginHref}>
                  Sign in with GitHub
                </a>
              ) : (
                <button class="btn btn-primary" type="button" disabled title="GITHUB_CLIENT_ID is not set">
                  Sign in with GitHub
                </button>
              )}
              <a class="btn" href="/#examples">
                See an example
              </a>
            </div>
          </div>
        </div>
      </main>
    )
  }
</Base>
