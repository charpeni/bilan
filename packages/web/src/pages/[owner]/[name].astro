---
import { GithubError, RepoNotFoundError } from '@bilan/core';
import { getRepoByName, touchRepoView } from '@bilan/store-d1';
import { env } from 'cloudflare:workers';

import RepoNotFound from '../../components/RepoNotFound.astro';
import UserMenu from '../../components/UserMenu.astro';
import Base from '../../layouts/Base.astro';
import { accessDeps, checkRepoAccess } from '../../lib/access.ts';
import { getDb } from '../../lib/db.ts';
import {
  findActiveJob,
  startSync,
  SyncAlreadyRunningError,
  SyncRateLimitedError,
} from '../../lib/jobs.ts';
import { loginHref as loginHrefFor } from '../../lib/oauth.ts';
import { isExampleRepo, isStale, needsRefresh } from '../../lib/stale.ts';

const { owner, name } = Astro.params as { owner: string; name: string };
const label = `${owner}/${name}`;
const user = Astro.locals.user;
const db = getDb(env);
const example = isExampleRepo(env, owner, name);
const loginHref = loginHrefFor(Astro.url.pathname);
const apiBase = `/api/repos/${encodeURIComponent(owner)}/${encodeURIComponent(name)}`;
const now = new Date().toISOString();

// Signed out, the answer never depends on what bilan has cached: only the
// example repo is served, on the server token; anything else is a login.
if (!user && !example) return Astro.redirect(loginHref, 302);

let repo = await getRepoByName(db, owner, name);
let view: 'ready' | 'syncing' | 'not-found' | 'unavailable';
/**
 * A job this viewer started, whose status they may read on `/api/sync/:id`.
 * Anyone else's job answers 404 there, so the page is never handed such an
 * id: it watches the payload endpoint instead (see `lib/poll.ts`).
 */
let ownJobId: string | null = null;
/** Whether some job is queued or running, whoever started it. */
let syncActive = false;
/** Why a sync could not be started right now, shown on the syncing page. */
let syncError: string | null = null;

// An unknown name takes the same GitHub round trip as a private row the viewer
// cannot see, so a login redirect, a 503, or the 404 page never tells them
// apart. A viewer whose token is gone throws `ReauthRequiredError`; the
// middleware sends them to login.
const access = await checkRepoAccess(accessDeps(env), user, repo ?? { owner, name });
if (access.kind === 'login-required') return Astro.redirect(loginHref, 302);
if (access.kind === 'unavailable') {
  view = 'unavailable';
} else if (access.kind === 'not-found') {
  view = 'not-found';
} else if (access.kind === 'ok') {
  if (!repo) throw new Error('an access decision of ok needs a cached row');
  if (user) await touchRepoView(db, { repoId: repo.id, userId: user.id, now });
  const active = await findActiveJob(db, repo.id);
  syncActive = active !== undefined;
  ownJobId = active && user && active.requestedBy === user.id ? active.id : null;
  view = repo.lastSyncedAt !== null ? 'ready' : 'syncing';
} else {
  // First view of a repo bilan has no row for (`unknown`), or of a name another
  // repo took over (`replaced`: the old row is parked by the sync, never
  // served): start its first sync on the token GitHub just answered on.
  try {
    const started = await startSync(
      env,
      { owner, name },
      { mode: 'incremental', depth: '30d', requestedBy: user?.id ?? null, source: access.source },
    );
    ownJobId = started.jobId;
    syncActive = true;
    view = 'syncing';
  } catch (error) {
    if (error instanceof SyncAlreadyRunningError) {
      // Someone else's job (or a cron's): watched through the payload endpoint.
      syncActive = true;
      view = 'syncing';
    } else if (error instanceof SyncRateLimitedError) {
      syncError = error.message;
      view = 'syncing';
    } else if (error instanceof RepoNotFoundError) {
      view = 'not-found';
    } else if (error instanceof GithubError) {
      view = 'unavailable';
    } else {
      throw error;
    }
  }
  repo = view === 'syncing' ? await getRepoByName(db, owner, name) : undefined;
  if (repo && user) await touchRepoView(db, { repoId: repo.id, userId: user.id, now });
}
if (view === 'unavailable') {
  Astro.response.status = 503;
  Astro.response.headers.set('retry-after', '60');
}

const syncedAt = repo?.lastSyncedAt ?? null;
const stale = isStale(syncedAt);
/** Signed-in viewers sync on their token; signed-out ones only the example repo on the server's. */
const canSync = user !== null || example;
/**
 * Kick off a background 30-day refresh on the viewer's token when the payload
 * is over an hour old, or when the last run was `partial` (cut by the page
 * budget) so the rest gets reconciled without waiting for the payload to age.
 */
const autoRefresh = user !== null && view === 'ready' && repo !== undefined && needsRefresh(repo);
---

<Base title={`${label} · bilan`}>
  {
    view === 'ready' && (
      <>
        <nav class="topbar">
          <a href="/">bilan</a>
          <span class="muted">{label}</span>
          {repo?.isPrivate && <span class="badge">private</span>}
          <span class="spacer" />
          <span class="muted">
            synced <time datetime={syncedAt}>{syncedAt}</time>
          </span>
          {stale && <span class="badge">stale</span>}
          {canSync && (
            <button class="button" type="button" id="resync">
              Refresh
            </button>
          )}
          <UserMenu user={user} />
        </nav>
        <div class="status" id="status" hidden />
        <div id="bilan" data-auto-refresh={autoRefresh ? '1' : '0'} />
        <script>
          import '@bilan/ui/dist/bilan-ui.css';
          import { mount } from '@bilan/ui';

          import {
            jobPollOutcome,
            nextWatch,
            payloadPollOutcome,
            POLL_INTERVAL_MS,
            readPayloadProbe,
            SYNCED_AT_HEADER,
            watchAfterSyncResponse,
          } from '../../lib/poll.ts';

          import type { JobProbe, PollOutcome, SyncWatch } from '../../lib/poll.ts';
          import type { Payload } from '@bilan/core';
          import type { Mounted, Range } from '@bilan/ui';

          const root = document.getElementById('bilan') as HTMLElement;
          const status = document.getElementById('status') as HTMLElement;
          const [, owner, name] = location.pathname.split('/');
          const base = `/api/repos/${owner}/${name}`;

          /** Range button -> sync depth; `'30'` is always covered so it never gets here. */
          const DEPTH: Record<Range, '30d' | '90d' | '180d' | 'all'> = {
            '30': '30d',
            '90': '90d',
            '180': '180d',
            all: 'all',
          };

          let mounted: Mounted | undefined;
          let loading = false;

          const show = (text: string, state?: 'error'): void => {
            status.hidden = false;
            status.textContent = text;
            if (state) status.dataset.state = state;
            else delete status.dataset.state;
          };

          const postSync = (depth: '30d' | '90d' | '180d' | 'all'): Promise<Response> =>
            fetch(`${base}/sync`, {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ depth }),
            });

          /** The `syncedAt` of the payload on screen: the baseline a wait for a newer one starts from. */
          let currentSyncedAt: string | null = null;

          /** Read the current payload; null while the first sync is still running. */
          async function fetchPayload(): Promise<Payload | null> {
            const response = await fetch(`${base}/payload`, { cache: 'no-store' });
            if (response.status === 202) return null;
            if (!response.ok) throw new Error(`Could not load payload (${response.status}).`);
            currentSyncedAt = response.headers.get(SYNCED_AT_HEADER) ?? currentSyncedAt;
            return (await response.json()) as Payload;
          }

          function render(payload: Payload, initialRange?: Range): void {
            mounted?.destroy();
            mounted = mount(root, payload, {
              theme: 'auto',
              ...(initialRange === undefined ? {} : { initialRange }),
              onLoadMore: (range) => void loadMore(range),
            });
            const time = document.querySelector<HTMLTimeElement>('.topbar time');
            if (time && payload.syncedAt) {
              time.dateTime = payload.syncedAt;
              time.textContent = payload.syncedAt;
            }
          }

          const sleep = (ms: number): Promise<void> =>
            new Promise((resolve) => setTimeout(resolve, ms));

          /** One probe of whatever the watch points at; see `lib/poll.ts` for the rules. */
          async function probe(watch: SyncWatch): Promise<PollOutcome> {
            if (watch.kind === 'job') {
              const response = await fetch(`/api/sync/${watch.jobId}`, { cache: 'no-store' });
              const job = response.ok ? ((await response.json()) as JobProbe) : null;
              return jobPollOutcome(response.status, job);
            }
            const response = await fetch(`${base}/payload`, { method: 'HEAD', cache: 'no-store' });
            return payloadPollOutcome(
              readPayloadProbe(response.status, response.headers),
              watch.baseline,
            );
          }

          /**
           * Resolve once a payload newer than the baseline is published; reject
           * when the sync failed or ended without one. Own jobs are read on
           * their row; anyone else's through the payload endpoint.
           */
          async function waitForSync(initial: SyncWatch, baseline: string | null): Promise<void> {
            let watch: SyncWatch | null = initial;
            while (watch !== null) {
              const outcome = await probe(watch);
              if (outcome.kind === 'ready') return;
              if (outcome.kind === 'failed') throw new Error(outcome.message);
              if (outcome.kind === 'stopped') {
                throw new Error('The running sync ended without a new payload; try again.');
              }
              watch = nextWatch(watch, outcome, baseline);
              if (outcome.kind === 'wait') await sleep(POLL_INTERVAL_MS);
            }
          }

          /** Ask for a deeper sync, wait for it, then mount again on the fresh payload. */
          async function loadMore(range: Range): Promise<void> {
            if (loading) return;
            loading = true;
            const label = range === 'all' ? 'full history' : `${range} more days`;
            show(`Loading ${label}…`);
            try {
              const baseline = currentSyncedAt;
              const response = await postSync(DEPTH[range]);
              const body = (await response.json().catch(() => ({}))) as {
                jobId?: string;
                message?: string;
              };
              // 409 means a sync is already running; ride along with it through the payload.
              const watch = watchAfterSyncResponse(response.status, body, baseline);
              if (watch === null) {
                throw new Error(body.message ?? `Sync refused (${response.status}).`);
              }
              await waitForSync(watch, baseline);
              const payload = await fetchPayload();
              if (!payload) throw new Error('Payload is not ready yet; reload the page.');
              status.hidden = true;
              render(payload, range);
            } catch (error) {
              show(error instanceof Error ? error.message : String(error), 'error');
            } finally {
              loading = false;
            }
          }

          async function load(): Promise<void> {
            try {
              const payload = await fetchPayload();
              if (!payload) {
                show('Syncing… the dashboard appears when the first sync finishes.');
                setTimeout(() => void load(), 5000);
                return;
              }
              status.hidden = true;
              render(payload);
            } catch (error) {
              show(error instanceof Error ? error.message : String(error), 'error');
            }
          }

          document.getElementById('resync')?.addEventListener('click', async (event) => {
            const button = event.currentTarget as HTMLButtonElement;
            button.disabled = true;
            const response = await postSync('30d');
            const body = (await response.json().catch(() => ({}))) as { message?: string };
            show(
              response.ok
                ? 'Refresh started; reload in a minute.'
                : (body.message ?? `Refresh refused (${response.status}).`),
            );
          });

          // Stale and signed in: refresh in the background. A running job (409) or a
          // recent sync (429) is fine; the next visit will pick up the result.
          if (root.dataset.autoRefresh === '1') {
            postSync('30d').catch(() => undefined);
          }

          void load();
        </script>
      </>
    )
  }
  {
    view === 'syncing' && (
      <main class="site">
        <h1>{label}</h1>
        <p id="message">
          {syncError ?? 'Syncing this repository for the first time…'}
        </p>
        <p class="muted" id="detail" />
        {!canSync && (
          <p class="muted">
            <a href={loginHref}>Sign in</a> to sync this repository on your own GitHub token.
          </p>
        )}
        <div
          id="sync"
          data-api-base={apiBase}
          data-own-job-id={ownJobId ?? ''}
          data-sync-active={syncActive ? '1' : '0'}
          data-auto-start={canSync && syncError === null ? '1' : '0'}
        />
        <script>
          import {
            jobPollOutcome,
            nextWatch,
            payloadPollOutcome,
            POLL_INTERVAL_MS,
            readPayloadProbe,
            watchAfterSyncResponse,
          } from '../../lib/poll.ts';

          import type { JobProbe, PollOutcome, SyncWatch } from '../../lib/poll.ts';

          const sync = document.getElementById('sync') as HTMLElement;
          const message = document.getElementById('message') as HTMLElement;
          const detail = document.getElementById('detail') as HTMLElement;
          const apiBase = sync.dataset.apiBase as string;
          const ownJobId = sync.dataset.ownJobId || null;
          const syncActive = sync.dataset.syncActive === '1';
          const autoStart = sync.dataset.autoStart === '1';

          const sleep = (ms: number): Promise<void> =>
            new Promise((resolve) => setTimeout(resolve, ms));

          /** One probe of whatever the watch points at; see `lib/poll.ts` for the rules. */
          async function probe(watch: SyncWatch): Promise<PollOutcome> {
            if (watch.kind === 'job') {
              const response = await fetch(`/api/sync/${watch.jobId}`, { cache: 'no-store' });
              const job = response.ok ? ((await response.json()) as JobProbe) : null;
              detail.textContent = `job ${watch.jobId}: ${job?.status ?? response.status}`;
              return jobPollOutcome(response.status, job);
            }
            const response = await fetch(`${apiBase}/payload`, {
              method: 'HEAD',
              cache: 'no-store',
            });
            detail.textContent = 'sync in progress';
            return payloadPollOutcome(readPayloadProbe(response.status, response.headers), null);
          }

          /**
           * Reload once the first payload is published. Own jobs are read on
           * their row; anyone else's through the payload endpoint, which never
           * needs a job id (see `lib/poll.ts`).
           */
          async function waitForSync(initial: SyncWatch): Promise<void> {
            let watch: SyncWatch | null = initial;
            while (watch !== null) {
              const outcome = await probe(watch);
              if (outcome.kind === 'ready') {
                location.reload();
                return;
              }
              if (outcome.kind === 'failed') {
                message.textContent = outcome.message;
                return;
              }
              if (outcome.kind === 'stopped') {
                message.textContent = 'The sync ended without publishing; reload to try again.';
                return;
              }
              watch = nextWatch(watch, outcome, null);
              if (outcome.kind === 'wait') await sleep(POLL_INTERVAL_MS);
            }
          }

          async function start(): Promise<void> {
            const response = await fetch(`${apiBase}/sync`, { method: 'POST' });
            const body = (await response.json().catch(() => ({}))) as {
              jobId?: string;
              message?: string;
            };
            const watch = watchAfterSyncResponse(response.status, body, null);
            if (watch === null) {
              message.textContent = body.message ?? `Sync refused (${response.status}).`;
              return;
            }
            await waitForSync(watch);
          }

          if (ownJobId) void waitForSync({ kind: 'job', jobId: ownJobId });
          else if (syncActive) void waitForSync({ kind: 'payload', baseline: null });
          else if (autoStart) void start();
        </script>
      </main>
    )
  }
  {view === 'not-found' && <RepoNotFound label={label} user={user} />}
  {
    view === 'unavailable' && (
      <main class="site">
        <h1>{label}</h1>
        <p>GitHub is unavailable right now, so bilan cannot tell whether you may see this repository.</p>
        <p class="muted">Try again in a minute.</p>
      </main>
    )
  }
</Base>
