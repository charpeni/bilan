---
import { env } from 'cloudflare:workers';

import Base from '../layouts/Base.astro';
import { EXAMPLES } from '../lib/examples.ts';
import { fmtDay } from '../lib/format.ts';
import { installUrl, isOauthConfigured, loginHref } from '../lib/oauth.ts';
import { previewTiles } from '../lib/preview.ts';

const user = Astro.locals.user;
const install = installUrl(env);
const firstExample = EXAMPLES[0];
const exampleHref = firstExample ? `/${firstExample.owner}/${firstExample.name}` : '#examples';
const primaryHref = user ? '/me' : isOauthConfigured(env) ? loginHref('/me') : exampleHref;
const primaryLabel = user ? 'Your repositories' : 'Sign in with GitHub';
---

<Base title="bilan" user={user} next="/me">
  <main class="container">
    <section class="lp-hero">
      <h1>Pull-request analytics that start the clock at ready for review.</h1>
      <p class="lp-sub">
        Throughput, cycle time, and review load for any GitHub repository you can read. Time spent
        in draft is never charged to the reviewers.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href={primaryHref}>{primaryLabel}</a>
        <a class="btn" href="#examples">See the examples</a>
      </div>
    </section>

    <section class="examples" id="examples" aria-label="Example dashboards">
      <p class="examples-meta">
        Two built-in examples, full history, no sign-in needed. Snapshots, not live data.
      </p>
      <div class="example-grid">
        {
          EXAMPLES.map((example) => (
            <article class="example-card">
              <div class="example-head">
                <a class="example-name" href={`/${example.owner}/${example.name}`}>
                  {example.repo}
                </a>
                <span class="example-when">
                  snapshot of {fmtDay(example.snapshotAt)} · {example.prs.toLocaleString()} PRs
                </span>
              </div>
              <p class="example-blurb">{example.blurb}</p>
              <p class="example-window">Last 30 days of the snapshot</p>
              <div class="tiles">
                {previewTiles(example.preview).map((t) => (
                  <div class="tile">
                    <div class="k">{t.k}</div>
                    <div class="v">{t.v}</div>
                    <div class="d">{t.d}</div>
                  </div>
                ))}
              </div>
              <a class="btn" href={`/${example.owner}/${example.name}`}>
                Open dashboard
              </a>
            </article>
          ))
        }
      </div>
    </section>

    <section class="features">
      <div class="feature">
        <svg class="icon" viewBox="0 0 16 16" aria-hidden="true">
          <path
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            d="M8 4v4l2.5 2.5M14 8A6 6 0 1 1 2 8a6 6 0 0 1 12 0Z"
          />
        </svg>
        <h3>Anchored at ready for review</h3>
        <p>
          Every latency runs from the moment a PR left draft, so a week of quiet work never reads as
          a week of slow review.
        </p>
      </div>
      <div class="feature">
        <svg class="icon" viewBox="0 0 16 16" aria-hidden="true">
          <path
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M9.5 2.5 6.5 13.5M3.5 5.5 1 8l2.5 2.5M12.5 5.5 15 8l-2.5 2.5"
          />
        </svg>
        <h3>Your token, one shared cache</h3>
        <p>
          Sync runs on your own GitHub token. The result is cached once and refreshed in the
          background, so coworkers open it instantly.
        </p>
      </div>
      <div class="feature">
        <svg class="icon" viewBox="0 0 16 16" aria-hidden="true">
          <path
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M6.5 9.5a3 3 0 0 0 4.24 0l2-2a3 3 0 0 0-4.24-4.24l-1 1M9.5 6.5a3 3 0 0 0-4.24 0l-2 2a3 3 0 0 0 4.24 4.24l1-1"
          />
        </svg>
        <h3>Links you can share</h3>
        <p>
          Every dashboard has a plain URL. Anyone who can see the repository on GitHub can open it;
          nobody else can.
        </p>
      </div>
    </section>

    <footer class="footer">
      <span>
        Private repositories need bilan installed on your organization{install && (
          <>
            {' '}(<a href={install}>install it on GitHub</a>)
          </>
        )}. The examples are snapshots shipped with the app; sign in to sync any repository live.
      </span>
      <a href="https://github.com/charpeni/bilan">bilan on GitHub</a>
    </footer>
  </main>
</Base>
