---
import { env } from 'cloudflare:workers';

import Base from '../layouts/Base.astro';
import { fmtSyncedAt } from '../lib/format.ts';
import { installUrl, isOauthConfigured, loginHref } from '../lib/oauth.ts';
import { examplePreview, PREVIEW_LABELS } from '../lib/preview.ts';

const exampleRepo = env.EXAMPLE_REPO;
const user = Astro.locals.user;
const install = installUrl(env);
const preview = await examplePreview(env);
const primaryHref = user ? '/me' : isOauthConfigured(env) ? loginHref('/me') : `/${exampleRepo}`;
const primaryLabel = user ? 'Your repositories' : 'Sign in with GitHub';
---

<Base title="bilan" user={user} next="/me">
  <main class="container">
    <section class="lp-hero">
      <h1>Pull-request analytics that start the clock at ready for review.</h1>
      <p class="lp-sub">
        Throughput, cycle time, and review load for any GitHub repository you can read. Time spent
        in draft is never charged to the reviewers.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href={primaryHref}>{primaryLabel}</a>
        <a class="btn" href={`/${exampleRepo}`}>See the example</a>
      </div>
    </section>

    <section class="preview" aria-label="Example dashboard">
      <p class="preview-meta">
        <a href={`/${exampleRepo}`}>{exampleRepo}</a>
        <span>
          {preview ? `last 30 days · synced ${fmtSyncedAt(preview.syncedAt)}` : 'not synced yet'}
        </span>
      </p>
      <div class="tiles">
        {
          preview
            ? preview.tiles.map((t) => (
                <div class="tile">
                  <div class="k">{t.k}</div>
                  <div class="v">{t.v}</div>
                  <div class="d">{t.d}</div>
                </div>
              ))
            : PREVIEW_LABELS.map((k) => (
                <div class="tile" aria-busy="true">
                  <div class="k">{k}</div>
                  <div class="v">
                    <span class="skel" />
                  </div>
                  <div class="d">
                    <span class="skel" />
                  </div>
                </div>
              ))
        }
      </div>
    </section>

    <section class="features">
      <div class="feature">
        <svg class="icon" viewBox="0 0 16 16" aria-hidden="true">
          <path
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            d="M8 4v4l2.5 2.5M14 8A6 6 0 1 1 2 8a6 6 0 0 1 12 0Z"
          />
        </svg>
        <h3>Anchored at ready for review</h3>
        <p>
          Every latency runs from the moment a PR left draft, so a week of quiet work never reads as
          a week of slow review.
        </p>
      </div>
      <div class="feature">
        <svg class="icon" viewBox="0 0 16 16" aria-hidden="true">
          <path
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M9.5 2.5 6.5 13.5M3.5 5.5 1 8l2.5 2.5M12.5 5.5 15 8l-2.5 2.5"
          />
        </svg>
        <h3>Your token, one shared cache</h3>
        <p>
          Sync runs on your own GitHub token. The result is cached once and refreshed in the
          background, so coworkers open it instantly.
        </p>
      </div>
      <div class="feature">
        <svg class="icon" viewBox="0 0 16 16" aria-hidden="true">
          <path
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M6.5 9.5a3 3 0 0 0 4.24 0l2-2a3 3 0 0 0-4.24-4.24l-1 1M9.5 6.5a3 3 0 0 0-4.24 0l-2 2a3 3 0 0 0 4.24 4.24l1-1"
          />
        </svg>
        <h3>Links you can share</h3>
        <p>
          Every dashboard has a plain URL. Anyone who can see the repository on GitHub can open it;
          nobody else can.
        </p>
      </div>
    </section>

    <footer class="footer">
      <span>
        Private repositories need bilan installed on your organization{install && (
          <>
            {' '}(<a href={install}>install it on GitHub</a>)
          </>
        )}.
      </span>
      <a href="https://github.com/charpeni/bilan">bilan on GitHub</a>
    </footer>
  </main>
</Base>
